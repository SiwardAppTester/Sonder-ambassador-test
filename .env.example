# Public — safe to expose
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — required for signed uploads + redemption fn invoker
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Demo controls
NEXT_PUBLIC_ENABLE_DEMO_RESET=false

# Feature: when true, mock providers stand in for real auth/org/permissions.
# Useful when the schema isn't deployed yet. Set to false once Supabase is wired.
NEXT_PUBLIC_USE_MOCK_PROVIDERS=true
